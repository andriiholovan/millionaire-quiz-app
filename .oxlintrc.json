{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "unicorn",
    "typescript",
    "oxc",
    "nextjs",
    "jsx-a11y",
    "jest",
    "vitest",
    "promise",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "package-lock.json",
    "public",
    "vitest.config.mts",
    "*.icon.{jsx,tsx}"
  ],
  "rules": {
    "eslint/no-inline-comments": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["@components/*", "@actions/*"],
            "message": "Use the public barrel instead of deep paths: @components or @actions."
          },
          {
            "group": [
              "@lib/!(client|server|shared)",
              "@lib/!(client|server|shared)/**"
            ],
            "message": "Use a public @lib alias: @lib/client, @lib/server, or @lib/shared."
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "import/no-unassigned-import": "off",
    "react/react-in-jsx-scope": "off",
    "sort-imports": [
      "error",
      {
        "allowSeparatedGroups": true,
        "ignoreCase": true,
        "ignoreDeclarationSort": true
      }
    ],
    "vitest/require-mock-type-parameters": "off"
  },
  "overrides": [
    {
      "files": ["*.test.{ts,tsx}"],
      "rules": {
        "max-lines-per-function": "off"
      }
    }
  ]
}
